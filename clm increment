def print_column_increment_triangle(n):
    for i in range(1, n + 1):
        # The first number in any row 'i' is always just 'i'
        current_value = i
        
        for j in range(1, i + 1):
            print(current_value, end=" ")
            # The next number in the row increases by the total rows minus column index
            current_value += (n - j)
        print()  # Move to the next row

 
rows = 5
print_column_increment_triangle(rows)
